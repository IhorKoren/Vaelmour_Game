{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "src/combat/engine.ts", "src/data/config/balance.ts", "src/progression/progression.ts", "src/types/game.ts"]
}
