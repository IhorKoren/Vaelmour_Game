{
  "name": "first-rift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run db:generate && npm run db:deploy",
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "dev:reset-player": "tsx server/scripts/resetPlayer.ts",
    "prebuild": "npm run db:generate",
    "build": "tsc -p tsconfig.server.json --noEmit && tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:db": "tsx server/scripts/verifyPostgresPersistence.ts",
    "test:watch": "vitest",
    "validate:content": "tsx server/scripts/validateContent.ts",
    "simulate:balance": "tsx server/scripts/simulateBalance.ts",
    "report:playtest": "tsx server/scripts/reportPlaytest.ts",
    "smoke:staging": "tsx server/scripts/stagingSmoke.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
